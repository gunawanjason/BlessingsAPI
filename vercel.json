{
  "version": 2,
  "builds": [
    {
      "src": "./api.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["json/verses/**", "json/pericope/**", "scripts/source_coverage.json", "index.html"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api.js"
    }
  ]
}
